        function victorySound() {
            initAudio();
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, index) => {
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.setValueAtTime(freq, audioContext.currentTime + index * 0.15);
                
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime + index * 0.15);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + index * 0.15 + 0.3);
                
                oscillator.start(audioContext.currentTime + index * 0.15);
                oscillator.stop(audioContext.currentTime + index * 0.15 + 0.3);
            });
        }

        // Speech Synthesis
        function speak(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'nn-NO';
                utterance.rate = 0.8;
                
                const voices = speechSynthesis.getVoices();
                const nnVoice = voices.find(voice => voice.lang.includes('nn'));
                const nbVoice = voices.find(voice => voice.lang.includes('nb'));
                
                if (nnVoice) {
                    utterance.voice = nnVoice;
                } else if (nbVoice) {
                    utterance.voice = nbVoice;
                }
                
                speechSynthesis.speak(utterance);
            }
        }

        // Screen Management
        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(screen => {
                screen.classList.remove('active');
            });
            document.getElementById(screenId).classList.add('active');
        }

        // Progress Dots
        function createProgressDots(containerId, total, current) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            for (let i = 0; i < total; i++) {
                const dot = document.createElement('div');
                dot.className = 'dot';
                if (i < current) dot.classList.add('completed');
                if (i === current) dot.classList.add('active');
                container.appendChild(dot);
            }
        }

        // Confetti
        function createConfetti() {
            const colors = ['#FF9418', '#FFD85A', '#6B3FA0', '#4CAF50', '#f44336'];
            for (let i = 0; i < 50; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.animation = `confetti-fall ${Math.random() * 3 + 2}s linear`;
                confetti.style.animationDelay = Math.random() * 2 + 's';
                document.body.appendChild(confetti);
                
                setTimeout(() => confetti.remove(), 5000);
            }
        }

        // Feedback
        function showFeedback(message, duration = 1500) {
            const feedback = document.getElementById('feedback');
            feedback.textContent = message;
            feedback.classList.add('show');
            setTimeout(() => feedback.classList.remove('show'), duration);
        }

        // Start Screen
        document.getElementById('start-btn').addEventListener('click', () => {
            const nameInput = document.getElementById('name-input');
            playerName = nameInput.value.trim();
            
            if (playerName) {
                localStorage.setItem('playerName', playerName);
                showScreen('level-select-screen');
            } else {
                nameInput.style.borderColor = '#f44336';
                setTimeout(() => nameInput.style.borderColor = '#FF9418', 1000);
            }
        });

        document.getElementById('name-input').addEventListener('input', (e) => {
            const welcomeMessage = document.getElementById('welcome-message');
            if (e.target.value.trim()) {
                welcomeMessage.textContent = `Hei, ${e.target.value.trim()}! 👻`;
                welcomeMessage.style.display = 'block';
            } else {
                welcomeMessage.style.display = 'none';
            }
        });

        // Load saved name
        const savedName = localStorage.getItem('playerName');
        if (savedName) {
            document.getElementById('name-input').value = savedName;
            document.getElementById('welcome-message').textContent = `Velkomen tilbake, ${savedName}! 🎃`;
            document.getElementById('welcome-message').style.display = 'block';
        }

        // Level Select
        document.querySelectorAll('.level-card').forEach(card => {
            card.addEventListener('click', () => {
                const level = parseInt(card.dataset.level);
                startLevel(level);
            });
        });

        document.getElementById('start-all-btn').addEventListener('click', () => {
            startLevel(1);
        });

        function startLevel(level) {
            currentLevel = level;
            currentWordIndex = 0;
            
            if (level === 1) {
                showScreen('level1-screen');
                initLevel1();
            } else if (level === 2) {
                showScreen('level2-screen');
                initLevel2();
            } else if (level === 3) {
                showScreen('level3-screen');
                initLevel3();
            }
        }

        // Level 1
        function initLevel1() {
            createProgressDots('level1-dots', words.length, currentWordIndex);
            document.getElementById('level1-score').textContent = scores.level1;
            showWord1();
        }

        function showWord1() {
            const word = words[currentWordIndex];
            document.getElementById('level1-emoji').textContent = word.emoji;
            document.getElementById('level1-article').textContent = word.article;
            document.getElementById('level1-word').textContent = word.word;
            document.getElementById('level1-russian').textContent = word.ru;
            
            createProgressDots('level1-dots', words.length, currentWordIndex);
        }

        document.getElementById('level1-speak-btn').addEventListener('click', () => {
            const word = words[currentWordIndex];
            speak(word.nn);
            
            const emoji = document.getElementById('level1-emoji');
            emoji.style.animation = 'none';
            setTimeout(() => emoji.style.animation = 'bounce 0.5s ease', 10);
        });

        document.getElementById('level1-next-btn').addEventListener('click', () => {
            scores.level1++;
            currentWordIndex++;
            
            if (currentWordIndex < words.length) {
                showWord1();
            } else {
                showFeedback('Flott! 🎃', 2000);
                setTimeout(() => startLevel(2), 2000);
            }
        });

        // Level 2
        function initLevel2() {
            createProgressDots('level2-dots', words.length, currentWordIndex);
            document.getElementById('level2-score').textContent = scores.level2;
            showWord2();
        }

        function showWord2() {
            const word = words[currentWordIndex];
            document.getElementById('level2-emoji').textContent = word.emoji;
            document.getElementById('level2-russian').textContent = word.ru;
            
            level2Answer = [];
            level2SelectedArticle = '';
            level2HintUsed = false;
            
            document.getElementById('level2-answer').innerHTML = '';
            document.querySelectorAll('.article-btn').forEach(btn => btn.classList.remove('selected'));
            
            if (word.article) {
                document.getElementById('level2-article-section').style.display = 'block';
            } else {
                document.getElementById('level2-article-section').style.display = 'none';
            }
            
            createLetterTiles(word.word);
            createProgressDots('level2-dots', words.length, currentWordIndex);
        }

        function createLetterTiles(word) {
            const container = document.getElementById('level2-letters');
            container.innerHTML = '';
            
            const letters = word.split('').sort(() => Math.random() - 0.5);
            letters.forEach((letter, index) => {
                const tile = document.createElement('div');
                tile.className = 'letter-tile';
                tile.textContent = letter;
                tile.dataset.index = index;
                tile.addEventListener('click', () => addLetter(letter, index));
                container.appendChild(tile);
            });
        }

        function addLetter(letter, index) {
            const tile = document.querySelector(`.letter-tile[data-index="${index}"]`);
            if (tile.classList.contains('used')) return;
            
            tile.classList.add('used');
            level2Answer.push({ letter, index });
            
            const answerArea = document.getElementById('level2-answer');
            const answerLetter = document.createElement('div');
            answerLetter.className = 'answer-letter';
            answerLetter.textContent = letter;
            answerLetter.dataset.answerIndex = level2Answer.length - 1;
            answerLetter.addEventListener('click', () => removeLetter(level2Answer.length - 1));
            answerArea.appendChild(answerLetter);
        }

        function removeLetter(answerIndex) {
            const answerLetter = document.querySelector(`.answer-letter[data-answer-index="${answerIndex}"]`);
            if (answerLetter) {
                const tileIndex = level2Answer[answerIndex].index;
                const tile = document.querySelector(`.letter-tile[data-index="${tileIndex}"]`);
                tile.classList.remove('used');
                
                level2Answer.splice(answerIndex, 1);
                document.getElementById('level2-answer').innerHTML = '';
                level2Answer.forEach((item, idx) => {
                    const letter = document.createElement('div');
                    letter.className = 'answer-letter';
                    letter.textContent = item.letter;
                    letter.dataset.answerIndex = idx;
                    letter.addEventListener('click', () => removeLetter(idx));
                    document.getElementById('level2-answer').appendChild(letter);
                });
            }
        }

        document.querySelectorAll('.article-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.article-btn').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                level2SelectedArticle = btn.dataset.article;
            });
        });

        document.getElementById('level2-hint-btn').addEventListener('click', () => {
            const word = words[currentWordIndex].word;
            if (level2Answer.length < word.length) {
                const nextLetter = word[level2Answer.length];
                const tiles = document.querySelectorAll('.letter-tile:not(.used)');
                tiles.forEach(tile => {
                    if (tile.textContent === nextLetter) {
                        tile.style.background = '#6B3FA0';
                        setTimeout(() => tile.style.background = '#FF9418', 1000);
                    }
                });
                level2HintUsed = true;
            }
        });

        document.getElementById('level2-check-btn').addEventListener('click', () => {
            const word = words[currentWordIndex];
            const answer = level2Answer.map(item => item.letter).join('');
            
            let articleCorrect = true;
            if (word.article) {
                articleCorrect = level2SelectedArticle === word.article;
            }
            
            if (answer === word.word && articleCorrect) {
                correctSound();
                createConfetti();
                showFeedback('🎉 Flott!', 1500);
                
                let points = 1;
                if (!level2HintUsed) points++;
                scores.level2 += points;
                document.getElementById('level2-score').textContent = scores.level2;
                
                setTimeout(() => {
                    currentWordIndex++;
                    if (currentWordIndex < words.length) {
                        showWord2();
                    } else {
                        showFeedback('Bra jobba! 🎃', 2000);
                        setTimeout(() => startLevel(3), 2000);
                    }
                }, 1500);
            } else {
                wrongSound();
                showFeedback('Prøv igjen! 👻', 1500);
                const card = document.querySelector('#level2-screen .word-card');
                card.style.animation = 'shake 0.5s ease';
                setTimeout(() => card.style.animation = '', 500);
                
                setTimeout(() => {
                    level2Answer = [];
                    document.getElementById('level2-answer').innerHTML = '';
                    document.querySelectorAll('.letter-tile').forEach(tile => tile.classList.remove('used'));
                }, 1500);
            }
        });

        // Level 3
        function initLevel3() {
            createProgressDots('level3-dots', words.length, currentWordIndex);
            document.getElementById('level3-score').textContent = scores.level3;
            showWord3();
        }

        function showWord3() {
            const word = words[currentWordIndex];
            const choices = document.getElementById('level3-choices');
            choices.innerHTML = '';
            
            const correctIndex = Math.floor(Math.random() * 4);
            const usedEmojis = new Set([word.emoji]);
            
            for (let i = 0; i < 4; i++) {
                const card = document.createElement('div');
                card.className = 'choice-card';
                
                let emoji;
                if (i === correctIndex) {
                    emoji = word.emoji;
                } else {
                    do {
                        const randomWord = words[Math.floor(Math.random() * words.length)];
                        emoji = randomWord.emoji;
                    } while (usedEmojis.has(emoji));
                    usedEmojis.add(emoji);
                }
                
                card.innerHTML = `<div class="choice-emoji">${emoji}</div>`;
                card.dataset.emoji = emoji;
                card.addEventListener('click', () => checkAnswer3(card, emoji, word.emoji));
                choices.appendChild(card);
            }
            
            setTimeout(() => speak(word.nn), 500);
            createProgressDots('level3-dots', words.length, currentWordIndex);
        }

        function checkAnswer3(card, selectedEmoji, correctEmoji) {
            if (selectedEmoji === correctEmoji) {
                card.classList.add('correct');
                correctSound();
                createConfetti();
                showFeedback('⭐ Bra jobba!', 1500);
                scores.level3++;
                document.getElementById('level3-score').textContent = scores.level3;
                
                setTimeout(() => {
                    currentWordIndex++;
                    if (currentWordIndex < words.length) {
                        showWord3();
                    } else {
                        showResults();
                    }
                }, 1500);
            } else {
                card.classList.add('wrong');
                wrongSound();
                showFeedback('Prøv igjen! 👻', 1500);
                setTimeout(() => card.classList.remove('wrong'), 500);
            }
        }

        document.getElementById('level3-speak-btn').addEventListener('click', () => {
            const word = words[currentWordIndex];
            speak(word.nn);
        });

        // Results
        function showResults() {
            totalScore = scores.level1 + scores.level2 + scores.level3;
            localStorage.setItem('bestScore', Math.max(totalScore, parseInt(localStorage.getItem('bestScore') || 0)));
            
            showScreen('results-screen');
            document.getElementById('results-title').textContent = `🎃 GRATULERER, ${playerName.toUpperCase()}!`;
            document.getElementById('results-score').textContent = totalScore;
            
            let badge;
            if (totalScore >= 27) badge = ' Halloween Master!';
            else if (totalScore >= 22) badge = '🎃 Halloween Star!';
            else if (totalScore >= 16) badge = '👻 Great Job!';
            else badge = '🕷️ Keep Learning!';
            
            document.getElementById('results-badge').textContent = badge;
            
            const learnedWords = document.getElementById('learned-words');
            learnedWords.innerHTML = '<h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 15px;">Du har lært:</h3>';
            words.forEach(word => {
                const div = document.createElement('div');
                div.className = 'learned-word';
                div.textContent = `${word.emoji} ${word.nn} — ${word.ru}`;
                learnedWords.appendChild(div);
            });
            
            createConfetti();
            victorySound();
        }

        document.getElementById('speak-all-btn').addEventListener('click', () => {
            let delay = 0;
            words.forEach((word, index) => {
                setTimeout(() => speak(word.nn), delay);
                delay += 2000;
            });
        });

        document.getElementById('restart-btn').addEventListener('click', () => {
            scores = { level1: 0, level2: 0, level3: 0 };
            currentWordIndex = 0;
            showScreen('level-select-screen');
        });

        // Initialize voices
        if ('speechSynthesis' in window) {
            speechSynthesis.getVoices();
            speechSynthesis.onvoiceschanged = () => speechSynthesis.getVoices();
        }
    </script>
